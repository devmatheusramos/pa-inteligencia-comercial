# Receptor dos webhooks
PORT=3000
# Chave para o HMAC do telefone do cliente
HMAC_TELEFONE_KEY=troque-por-uma-chave-aleatoria

# Evolution API — fonte principal (ADR 0003)
EVOLUTION_URL=http://localhost:8080
# Chave administrativa da Evolution (só para chamadas do nosso lado)
EVOLUTION_API_KEY=troque-por-uma-chave-aleatoria
# Instância = um número de vendedor
EVOLUTION_INSTANCE=vendedor-teste
# Token da instância; a Evolution devolve no campo apikey de cada webhook
EVOLUTION_INSTANCE_TOKEN=troque-por-outro-token-aleatorio
# Do contêiner da Evolution até o receptor rodando no seu PC
EVOLUTION_WEBHOOK_URL=http://host.docker.internal:3000/webhook/evolution

# Cloud API oficial — plano B (ADR 0001)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Banco local (docker compose)
DATABASE_URL=postgres://pa:pa@localhost:5432/pa
