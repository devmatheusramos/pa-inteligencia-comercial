# Receptor do webhook (prova de viabilidade)
PORT=3000
# Token escolhido por você e repetido no painel da Meta (Webhooks > Verify token)
WHATSAPP_VERIFY_TOKEN=troque-por-um-token-aleatorio
# Meta for Developers > App > Configurações > Básico > Chave secreta do app
WHATSAPP_APP_SECRET=
# Chave para o HMAC do telefone do cliente
HMAC_TELEFONE_KEY=troque-por-uma-chave-aleatoria
# Banco local (docker compose)
DATABASE_URL=postgres://pa:pa@localhost:5432/pa
